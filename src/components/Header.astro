<style>
	@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Raleway:wght@300;400;500;600;700&display=swap');
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --brown: #3D2314;
      --brown-mid: #6B3D22;
      --brown-light: #A0693A;
      --cream: #F5EFE0;
      --cream-dark: #E8DFC8;
      --cream-deeper: #D4C5A9;
      --text-dark: #2A1709;
      --text-mid: #5C3D22;
      --accent: #C4872A;
    }
    body { background: var(--cream); font-family: 'Raleway', sans-serif; }

    /* NAV - light cream */
    nav {
      background: var(--cream);
      padding: 16px 48px;
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1.5px solid var(--cream-deeper);
      position: relative; z-index: 20;
    }
    .nav-logo { display: flex; align-items: center; gap: 14px; }
    .nav-logo img { width: 50px; height: 50px; border-radius: 50%; }
    .nav-brand {
      font-family: 'Cinzel', serif;
      color: var(--brown);
      font-size: 15px;
      letter-spacing: 0.1em;
      line-height: 1.3;
      font-weight: 600;
    }
    .nav-brand span {
      display: block; font-size: 10px;
      color: var(--brown-light); letter-spacing: 0.2em;
      font-weight: 400; font-family: 'Raleway', sans-serif;
      text-transform: uppercase; margin-top: 2px;
    }
    .nav-links { display: flex; gap: 36px; align-items: center; }
    .nav-links a {
      font-family: 'Cinzel', sans-serif; font-size: 11px; font-weight: 600;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--text-dark); text-decoration: none; cursor: pointer;
    }
    .nav-links a:hover { color: var(--accent); }
    a.nav-cart {
      background: var(--brown); color: var(--cream);
      font-family: 'Raleway', sans-serif; font-size: 11px; font-weight: 700;
      letter-spacing: 0.15em; text-transform: uppercase;
      padding: 9px 20px; border: none; cursor: pointer;
      text-decoration: none;
    }

</style>
