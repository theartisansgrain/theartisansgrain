---
// src/components/BannerStrip.astro
interface Props {
  eyebrow:        string;
  heading:        string;
  body:           string;
  ctaPrimary:     string;
  ctaPrimaryHref: string;
  ctaSecondary?:  string;
  ctaSecondaryHref?: string;
}
const { eyebrow, heading, body, ctaPrimary, ctaPrimaryHref, ctaSecondary, ctaSecondaryHref } = Astro.props;
---

<div class="banner-strip bg-accent">
  <div>
    <div class="eyebrow" style="color:rgba(245,239,224,.7)">{eyebrow}</div>
    <h2 class="h-section text-cream" style="font-size:clamp(20px,3vw,28px);margin-bottom:12px;">{heading}</h2>
    <p class="body-copy" style="color:rgba(245,239,224,.8);max-width:520px;">{body}</p>
  </div>
  <div class="banner-ctas">
    <a href={ctaPrimaryHref} class="btn btn-primary">{ctaPrimary}</a>
    {ctaSecondary && ctaSecondaryHref && (
      <a href={ctaSecondaryHref} class="btn btn-ghost">{ctaSecondary}</a>
    )}
  </div>
</div>
