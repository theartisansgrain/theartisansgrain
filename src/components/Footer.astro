---
const today = new Date();
---
<footer>
    <div class="footer-top">
      <div class="footer-brand">
        <h3>The Artisan's Grain</h3>
        <p>Handcrafted wooden epoxy bow ties made one at a time in Texas. Every piece is numbered, signed, and entirely unique.</p>
      </div>
      <!-- temp until rest of pages are created -->
      <div class="footer-col"></div>
      <div class="footer-col">
        <h4>Shop</h4>
        <a href="https://theartisansgrain.square.site">All Bow Ties</a>
        <!-- <a>New Arrivals</a>
        <a>Custom Orders</a>
        <a>Gift Cards</a> -->
      </div>
      <!-- <div class="footer-col">
        <h4>Info</h4>
        <a>Our Story</a>
        <a>The Process</a>
        <a>Shipping &amp; Returns</a>
        <a>Contact</a>
      </div> -->
    </div>
    <div class="footer-bottom">
      <div class="footer-copy">© {today.getFullYear()} The Artisan's Grain · Cleburne, Texas · All rights reserved.</div>
      <div class="footer-logo">
        <img src="/mnt/user-data/uploads/Logo_TAG.png" alt="Logo" />
      </div>
    </div>
  </footer>
<style>
	
    /* FOOTER */
    footer {
      background: var(--text-dark);
      padding: 48px 40px 28px;
    }
    .footer-top {
      display: grid;
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: 48px;
      padding-bottom: 40px;
      border-bottom: 1px solid rgba(245,239,224,0.1);
      margin-bottom: 24px;
    }
    .footer-brand h3 {
      font-family: 'Cinzel', serif;
      font-size: 18px;
      font-weight: 600;
      color: var(--cream);
      margin-bottom: 12px;
    }
    .footer-brand p {
      font-family: 'Raleway', sans-serif;
      font-size: 12px;
      font-weight: 300;
      color: rgba(245,239,224,0.5);
      line-height: 1.7;
    }
    .footer-col h4 {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--cream);
      margin-bottom: 16px;
    }
    .footer-col a {
      display: block;
      font-family: 'Raleway', sans-serif;
      font-size: 12px;
      font-weight: 300;
      color: rgba(245,239,224,0.5);
      text-decoration: none;
      margin-bottom: 8px;
      cursor: pointer;
    }
    .footer-col a:hover { color: var(--accent); }
    .footer-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .footer-copy {
      font-family: 'Raleway', sans-serif;
      font-size: 11px;
      color: rgba(245,239,224,0.3);
    }
    .footer-logo { display: flex; align-items: center; gap: 10px; }
    .footer-logo img { width: 32px; height: 32px; border-radius: 50%; opacity: 0.5; }

    .divider-ornament {
      text-align: center;
      padding: 24px 0 0;
      font-family: 'Cinzel', serif;
      font-size: 18px;
      color: var(--accent);
      opacity: 0.4;
      letter-spacing: 8px;
    }

    .bowtie-svg { width: 100px; height: 80px; }
</style>
