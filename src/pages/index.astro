---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_KEYWORDS } from '../consts';

---

<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} keywords={SITE_KEYWORDS} />
  <style>
    
  </style>
</head>
<body>
  <Header />

  <!-- HERO WITH WOOD GRAIN BG -->
  <div class="hero">
    <div class="hero-bg">
      <svg class="hero-grain-svg" viewBox="0 0 900 560" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 80 Q150 60 300 90 Q450 120 600 85 Q750 50 900 80" stroke="#C4872A" stroke-width="1.5" fill="none"/>
        <path d="M0 110 Q200 88 400 118 Q600 148 900 108" stroke="#A0693A" stroke-width="1" fill="none"/>
        <path d="M0 140 Q180 125 360 145 Q540 165 720 138 Q810 125 900 142" stroke="#6B3D22" stroke-width="2" fill="none"/>
        <path d="M0 175 Q120 162 240 178 Q480 210 720 170 Q810 155 900 175" stroke="#8B5A30" stroke-width="1" fill="none"/>
        <path d="M0 210 Q200 195 400 215 Q600 235 900 205" stroke="#5C3418" stroke-width="1.5" fill="none"/>
        <path d="M0 250 Q100 238 200 255 Q400 280 600 248 Q750 228 900 250" stroke="#A0693A" stroke-width="0.8" fill="none"/>
        <path d="M0 290 Q220 272 440 292 Q660 312 900 285" stroke="#6B3D22" stroke-width="2.5" fill="none"/>
        <path d="M0 330 Q180 315 360 335 Q540 355 720 325 Q810 312 900 330" stroke="#C4872A" stroke-width="1" fill="none"/>
        <path d="M0 370 Q150 355 300 372 Q450 389 600 360 Q750 338 900 368" stroke="#8B5A30" stroke-width="1.5" fill="none"/>
        <path d="M0 410 Q200 395 400 412 Q600 429 900 402" stroke="#5C3418" stroke-width="1" fill="none"/>
        <path d="M0 450 Q120 438 240 452 Q480 472 720 442 Q810 430 900 450" stroke="#A0693A" stroke-width="2" fill="none"/>
        <path d="M0 490 Q200 477 400 493 Q600 509 900 482" stroke="#6B3D22" stroke-width="1" fill="none"/>
        <path d="M0 520 Q180 508 360 523 Q540 538 720 510 Q810 498 900 520" stroke="#C4872A" stroke-width="0.8" fill="none"/>
        <!-- knot detail center-right -->
        <ellipse cx="680" cy="200" rx="38" ry="28" stroke="#8B5A30" stroke-width="1.5" fill="none"/>
        <ellipse cx="680" cy="200" rx="22" ry="16" stroke="#C4872A" stroke-width="1" fill="none"/>
        <ellipse cx="680" cy="200" rx="9" ry="6" stroke="#A0693A" stroke-width="1.5" fill="none" opacity="0.6"/>
        <!-- secondary knot -->
        <ellipse cx="760" cy="380" rx="28" ry="20" stroke="#6B3D22" stroke-width="1.2" fill="none"/>
        <ellipse cx="760" cy="380" rx="14" ry="10" stroke="#A0693A" stroke-width="1" fill="none"/>
        <!-- vertical grain cracks -->
        <path d="M580 0 Q583 80 580 160 Q577 240 582 320 Q585 400 580 560" stroke="#3D2314" stroke-width="1.5" fill="none" opacity="0.5"/>
        <path d="M620 0 Q618 120 622 240 Q626 360 620 560" stroke="#5C3418" stroke-width="0.8" fill="none" opacity="0.4"/>
      </svg>
    </div>
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <div class="hero-eyebrow">Handcrafted · Subtle · Unique · Texas</div>
      <h1 class="hero-title">
        Epoxy Poured
        <em>Wooden Bow Ties</em>
      </h1>
      <p class="hero-sub">Each piece is hand-shaped from reclaimed cedar wood, inlaid with custom-tinted epoxy resin, and finished to a mirror polish - wearable art unlike anything else.</p>
      <div class="hero-ctas">
        <a href="https://theartisansgrain.square.site" class="hero-cta-primary">Shop the Collection</a>
        <!-- <a href="https://theartisansgrain.square.site" class="hero-cta-secondary">Learn Our Process</a> -->
      </div>
      <div class="hero-stats" style="margin-top:40px;">
        <div class="hero-stat">
          <span class="hero-stat-num">90%</span>
          <span class="hero-stat-lbl">Handmade</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-num">10%</span>
          <span class="hero-stat-lbl">Lasered</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-num">1/1</span>
          <span class="hero-stat-lbl">Each Unique</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-num">2 Weeks</span>
          <span class="hero-stat-lbl">Per Piece</span>
        </div>
      </div>
    </div>

    <div class="hero-right">
      <div class="hero-medallion">
        <img src="https://raw.githubusercontent.com/theartisansgrain/landingpage/refs/heads/main/src/components/TAG_LOGO_JAR.svg" alt="The Artisan's Grain" />
      </div>
      <div class="hero-medallion-label">Cleburne, Texas · Est. 2025</div>
    </div>
  </div>

  <!-- VALUE BAR -->
  <div class="value-bar">
    <div class="vb-item"><div class="vb-dot"></div> Handcrafted One at a Time</div>
    <div class="vb-item"><div class="vb-dot"></div> Reclaimed wood</div>
    <div class="vb-item"><div class="vb-dot"></div> Custom Commissions Welcome</div>
    <div class="vb-item"><div class="vb-dot"></div> Ships Only in USA</div>
  </div>

  <!-- PRODUCTS -->
  <div class="section">
    <div class="section-label">The Collection</div>
    <div class="section-title">Featured Bow Ties</div>
    <p class="section-sub">Although Lasered patterned, every Wooden Bowtie is truely unique on wood grain patterns.</p>
    <div class="products-grid">
      <div class="product-card">
        <div class="product-img">
          <img style="width: 100%; height: 100%; object-fit: cover;" src="data:image/webp;base64,"/>
          <div class="product-badge-new">New</div>
        </div>
        <div class="product-info">
          <div class="product-wood">Cedar + Clear Resin</div>
          <div class="product-name">Criss Cross Wooden Bow Tie</div>
          <p class="product-desc">Cedar grain wood with epoxy pour geometric lattice patterns.</p>
          <div class="product-footer">
            <div class="product-price">$50</div>
            <a href="https://theartisansgrain.square.site/product/criss-cross/OKKRCR54GXEBN2HNIK2IM3NH?cp=true&sa=false&sbp=false&q=false&category_id=HIEJEZTH7JAFOMOLZUSMN2U6" class="product-btn">Learn More</a>
          </div>
        </div>
      </div>
      <div class="product-card">
        <div class="product-img">
          <img  style="width: 100%; height: 100%; object-fit: cover;" src='https://raw.githubusercontent.com/theartisansgrain/landingpage/refs/heads/main/src/components/Stripes.png'/>
        </div>
        <div class="product-info">
          <div class="product-wood">Cedar + Teal Resin</div>
          <div class="product-name">Stripes Wooden Bow Tie</div>
          <p class="product-desc">Handcrafted wooden bowtie with to horizontal stripes give it a simple, yet classic look.</p>
          <div class="product-footer">
            <div class="product-price">$50</div>
            <a href="https://theartisansgrain.square.site/product/race-stripes-bow-tie/10?cp=true&sa=false&sbp=false&q=false&category_id=HIEJEZTH7JAFOMOLZUSMN2U6" class="product-btn">Learn More</a>
          </div>
        </div>
      </div>
      <div class="product-card">
        <div class="product-img">
          <img  style="width: 100%; height: 100%; object-fit: cover;" src='https://raw.githubusercontent.com/theartisansgrain/landingpage/refs/heads/main/src/components/Broken.png'/>
          <div class="product-badge-new">New</div>
        </div>
        <div class="product-info">
          <div class="product-wood">Cedar + Clear Resin</div>
          <div class="product-name">Broken Pieces Wooden Bow Tie</div>
          <p class="product-desc">Broken peices was designed after going trails in my life and yet God was their to hold me together to get me through.</p>
          <div class="product-footer">
            <div class="product-price">$50</div>
            <a href="https://theartisansgrain.square.site/product/broken-pieces/44NCP7M6XRCHYZCHDO5UH67Q?cp=true&sa=false&sbp=false&q=false&category_id=HIEJEZTH7JAFOMOLZUSMN2U6" class="product-btn">Learn More</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="craft-section">
    <div class="craft-text">
      <div class="section-label">Our Process</div>
      <div class="section-title">Craft Without Shortcuts</div>
      <p class="section-sub">Every bow tie takes two weeks from raw lumber to finished accessory. Here's how we do it.</p>
      <div class="craft-steps">
        <div class="craft-step">
          <div class="step-num">01</div>
          <div class="step-text"><h4>Select the Wood</h4><p>We source cedar wood - chosen for figure and character.</p></div>
        </div>
        <div class="craft-step">
          <div class="step-num">02</div>
          <div class="step-text"><h4>Cut out Shape</h4><p>Lasered pattern with precision, then cut out the shape for the resin inlay - each bow tie is done by hand after laser is run.</p></div>
        </div>
        <div class="craft-step">
          <div class="step-num">03</div>
          <div class="step-text"><h4>Pour the Resin</h4><p>Custom - epoxy with/out pigment tint is poured, allowed to cure 72 — 120 hours.</p></div>
        </div>
        <div class="craft-step">
          <div class="step-num">04</div>
          <div class="step-text"><h4>Shaped &amp; Sanded</h4><p>After pour it has to be shaped and sanded flush through from 40 grits all the way to 220 grits.</p></div>
        </div>
        <div class="craft-step">
          <div class="step-num">05</div>
          <div class="step-text"><h4>Finish &amp; Fit</h4><p>Hand-buffed, fitted with an adjustable neck band.</p></div>
        </div>
      </div>
    </div>
    <div class="craft-visual">
      <div class="craft-logo-frame">
        <img src="https://raw.githubusercontent.com/theartisansgrain/landingpage/refs/heads/main/src/components/TAG_LOGO_JAR.svg" alt="The Artisan's Grain" />
      </div>
    </div>
  </div>

  <div class="testimonials">
    <div class="section-label">Customer Stories</div>
    <div class="section-title">Worn &amp; Loved</div>
    <p class="section-sub">From Work Place to gallery openings, here's what our customers are saying.</p>
    <div class="testi-grid">
      <div class="testi-card">
        <div class="stars">★★★★★</div>
        <p class="testi-text">"Wonderful Product with fantastic customer service. Timothy was great to work with. Beautiful custom bowtie with excellent detail. Fast turn around."</p>
        <div class="testi-author">- A. Johnson, West Frankfort, IL</div>
      </div>
      <div class="testi-card">
        <div class="stars">★★★★★</div>
        <p class="testi-text">"I now have several bow ties from The Artisan’s Grain, and I genuinely love every single one. The craftsmanship and unique designs really stand out.

One of my bow ties did chip at one point, but I was incredibly impressed with how easy the repair process was. It was smooth, hassle-free, and the finished repair looks just as good as new.

Great products and excellent customer service. Highly recommend!"</p>
        <div class="testi-author">- H. Stowell, Hinsdale, IL</div>
      </div>
      <!-- <div class="testi-card">
        <div class="stars">★★★★★</div>
        <p class="testi-text">"Got mine two years ago, and broke it in the process of moving. I contacted Timothy and he was very helpful on repairing the bow tie."</p>
        <div class="testi-author">- H. Stowell,  Hinsdale, IL</div>
      </div> -->
      <!-- <div class="testi-card">
        <div class="stars">★★★★★</div>
        <p class="testi-text">"My first Wooden bow tie I've ever owned. It is of good quality."</p>
        <div class="testi-author">- A. Tremper, Dunlap, TN</div>
      </div> -->
    </div>
  </div>

  <Footer />
</body>
</html>
