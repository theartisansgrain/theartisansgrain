---
// src/pages/404.astro
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Browse the shop or head home."
>
  <section class="page-hero" style="min-height:360px;">
    <svg class="hero-grain-svg" viewBox="0 0 1200 360" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path d="M0 48 Q200 32 400 56 Q650 84 900 44 Q1050 24 1200 50" stroke="#C4872A" stroke-width="1.5" fill="none"/>
      <path d="M0 130 Q250 114 500 138 Q750 162 1000 122 Q1100 104 1200 132" stroke="#A0693A" stroke-width="1" fill="none"/>
      <path d="M0 220 Q180 206 360 228 Q560 252 760 214 Q980 180 1200 222" stroke="#6B3D22" stroke-width="2" fill="none"/>
      <path d="M0 310 Q220 296 440 318 Q700 344 950 304 Q1080 284 1200 312" stroke="#8B5A30" stroke-width="1.5" fill="none"/>
    </svg>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div>
        <div class="eyebrow">404 — Page Not Found</div>
        <h1 class="h-display">This Grain<br><em>Doesn't Exist.</em></h1>
      </div>
      <div class="hero-right">
        <p class="hero-quote">The page you're looking for has either moved, been sold, or never existed. The bow ties are still here, though.</p>
      </div>
    </div>
  </section>

  <div class="section-wrap bg-cream" style="text-align:center;">
    <p class="body-copy" style="margin-bottom:28px;max-width:480px;margin-left:auto;margin-right:auto;">
      Try heading back to the shop, or use the search below to find what you're after.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="/shop/" class="btn btn-primary">Browse the Shop</a>
      <a href="/" class="btn btn-ghost" style="color:var(--brown);border-color:var(--cream-deeper);">Go Home</a>
    </div>
  </div>

</BaseLayout>
