---
// src/pages/gift-cards.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import BannerStrip from '@components/BannerStrip.astro';

const amounts = ['50','75','100','150'];

const howSteps = [
  ['01','You Purchase',    'Choose an amount, add a personal message, and pick a delivery date. We handle the rest.'],
  ['02','They Receive It', 'A beautifully formatted email arrives with the card, your message, and a unique redemption code.'],
  ['03','They Browse',     "They visit the shop, pick the piece that speaks to them, and apply the code at checkout."],
  ['04','It Ships to Them','Their chosen bow tie — numbered, signed, gift-wrapped — ships directly to their door.'],
];

const infoItems = [
  ['Never Expires',            "Gift cards have no expiry date and no dormancy fees. Valid until every last cent is used."],
  ['Redeemable on Everything', "Use it on any bow tie in the standard collection, a custom commission, or split across multiple orders. No restrictions."],
  ['Instant Digital Delivery', "Delivered by email within minutes. Schedule delivery for a future date and we'll send it exactly then."],
];
---

<BaseLayout
  title="Gift Cards"
  description="Give the gift of choosing — an Artisan's Grain digital gift card, delivered by email, never expires."
>
  <Hero
    eyebrow="Gift Cards"
    title="The Gift of<br><em>Choosing.</em>"
    quote="When you're not sure which piece they'd love — let them pick it themselves."
    height={320}
  />

  <!-- MAIN: PREVIEW + FORM -->
  <div class="split-grid" style="min-height:560px;">

    <!-- LEFT: Card preview -->
    <div class="panel-dark" style="align-items:center;justify-content:center;display:flex;">
      <svg class="panel-grain" viewBox="0 0 600 580" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <path d="M0 50 Q150 38 300 55 Q450 72 600 48" stroke="#C4872A" stroke-width="1" fill="none"/>
        <path d="M0 200 Q100 186 200 204 Q350 225 600 194" stroke="#A0693A" stroke-width="1.5" fill="none"/>
        <path d="M0 380 Q160 366 320 386 Q430 400 600 373" stroke="#C4872A" stroke-width="1" fill="none"/>
      </svg>
      <div style="position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:24px;">
        <div style="font-family:var(--font-sans);font-size:10px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:rgba(245,239,224,.3);">Gift Card Preview</div>

        <!-- The card -->
        <div
          id="gc-card"
          style="width:320px;height:200px;background:var(--brown-mid);border-radius:8px;padding:22px;position:relative;overflow:hidden;cursor:pointer;transition:transform .4s;"
          onclick="this.style.transform=this.style.transform?'':'rotateY(8deg) scale(1.02)'"
          role="button"
          aria-label="Gift card preview"
          tabindex="0"
        >
          <svg style="position:absolute;inset:0;opacity:.15;width:100%;height:100%;" viewBox="0 0 320 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <path d="M0 25 Q80 16 160 28 Q240 40 320 22" stroke="#F5EFE0" stroke-width="1.2" fill="none"/>
            <path d="M0 75 Q70 64 140 80 Q220 98 320 68" stroke="#F5EFE0" stroke-width="1" fill="none"/>
            <path d="M0 130 Q100 119 200 136 Q265 148 320 122" stroke="#F5EFE0" stroke-width="1.5" fill="none"/>
            <path d="M0 178 Q80 168 160 182 Q248 196 320 172" stroke="#F5EFE0" stroke-width="1.2" fill="none"/>
          </svg>
          <div style="position:relative;z-index:2;display:flex;justify-content:space-between;align-items:flex-start;">
            <span style="font-family:var(--font-serif);font-size:11px;font-weight:600;letter-spacing:.12em;color:rgba(245,239,224,.7);">The Artisan's Grain</span>
            <span style="font-family:var(--font-sans);font-size:8px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;background:var(--accent);color:var(--cream);padding:3px 8px;">Gift Card</span>
          </div>
          <div style="position:relative;z-index:2;display:flex;justify-content:center;margin:10px 0;">
            <svg viewBox="0 0 100 60" fill="none" style="width:100px;" aria-hidden="true">
              <path d="M6 30 C14 16 34 14 50 30 C34 46 14 44 6 30Z" fill="#5C3418" stroke="#8B5A30" stroke-width="1"/>
              <path d="M94 30 C86 16 66 14 50 30 C66 46 86 44 94 30Z" fill="#5C3418" stroke="#8B5A30" stroke-width="1"/>
              <path d="M42 20 C45 24 45 36 42 40 L58 40 C55 36 55 24 58 20Z" fill="#4a2810" stroke="#8B5A30" stroke-width="1"/>
              <path d="M10 24 Q50 18 90 24" stroke="#C4872A" stroke-width="1.8" fill="none"/>
              <path d="M10 32 Q50 26 90 32" stroke="#E8A84A" stroke-width="1.2" fill="none"/>
            </svg>
          </div>
          <div style="position:relative;z-index:2;display:flex;justify-content:space-between;align-items:flex-end;">
            <div>
              <div id="gc-amount-display" style="font-family:var(--font-serif);font-size:28px;font-weight:700;color:var(--cream);">$75</div>
              <div style="font-family:var(--font-sans);font-size:7px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:rgba(245,239,224,.4);">Gift Certificate</div>
            </div>
            <div style="font-family:var(--font-sans);font-size:8px;letter-spacing:.12em;color:rgba(245,239,224,.3);">TAG-GIFT-••••</div>
          </div>
        </div>

        <!-- Amount selector -->
        <div style="display:flex;gap:10px;" id="preview-amounts">
          {amounts.map(amt => (
            <button
              class={`pill pill-dark${amt === '75' ? ' active' : ''}`}
              data-amount={amt}
              style="font-family:var(--font-serif);font-size:15px;font-weight:600;min-width:52px;"
            >${amt}</button>
          ))}
        </div>
      </div>
    </div>

    <!-- RIGHT: Purchase form -->
    <div class="panel-light">
      <div class="eyebrow">Purchase a Gift Card</div>
      <h2 class="h-section" style="margin-bottom:8px;">Let Them Choose Their Own Piece.</h2>
      <p class="body-copy" style="margin-bottom:28px;">Delivered by email — to you or directly to the recipient. Never expires. Redeemable on any bow tie or custom commission.</p>

      <div class="form-row">
        <div class="field-label">Gift Card Amount</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;" id="form-amounts">
          {amounts.map(amt => (
            <button
              type="button"
              class={`pill${amt === '75' ? ' selected' : ''}`}
              data-amount={amt}
              style="font-family:var(--font-serif);font-size:15px;font-weight:600;min-width:56px;"
            >${amt}</button>
          ))}
          <button type="button" class="pill" data-amount="custom" style="font-size:11px;">Custom</button>
        </div>
        <div id="custom-amount-row" style="display:none;margin-top:10px;">
          <span style="background:var(--cream-deeper);border:1px solid var(--cream-deeper);padding:12px 14px;font-family:var(--font-serif);font-size:16px;color:var(--text-mid);">$</span>
          <input class="field-input" type="number" min="25" placeholder="Enter amount (min $25)" style="border-left:none;width:calc(100% - 48px);" />
        </div>
      </div>

      <div class="form-row-2">
        <div>
          <label class="field-label" for="gc-recipient-name">Recipient's Name</label>
          <input class="field-input" type="text" id="gc-recipient-name" autocomplete="name" placeholder="Thomas" />
        </div>
        <div>
          <label class="field-label" for="gc-recipient-email">Recipient's Email</label>
          <input class="field-input" type="email" id="gc-recipient-email" placeholder="thomas@email.com" />
        </div>
      </div>

      <div class="form-row-2">
        <div>
          <label class="field-label" for="gc-from">Your Name</label>
          <input class="field-input" type="text" id="gc-from" autocomplete="given-name" placeholder="From whom?" />
        </div>
        <div>
          <label class="field-label" for="gc-send-date">Send On</label>
          <input class="field-input" type="date" id="gc-send-date" />
        </div>
      </div>

      <div class="form-row">
        <label class="field-label" for="gc-message">Personal Message (Optional)</label>
        <textarea class="field-textarea" id="gc-message" rows="3" placeholder="Write a note to include with the gift card — delivered exactly as written."></textarea>
      </div>

      <button
        class="btn btn-primary"
        style="width:100%;padding:17px;"
        id="gc-submit"
        onclick="this.innerHTML='Gift Card Purchased — Check Your Email Shortly';this.style.background='var(--brown-mid)';this.disabled=true;"
      >
        Purchase Gift Card · <span id="gc-submit-label">$75</span>
      </button>
      <p class="body-copy" style="font-size:10px;text-align:center;margin-top:10px;color:var(--text-mid);">
        Gift cards delivered by email within minutes. No expiry. No fees.
      </p>
    </div>
  </div>

  <!-- HOW IT WORKS -->
  <section class="section-wrap bg-cream-d">
    <div class="eyebrow">Simple as It Should Be</div>
    <h2 class="h-section" style="margin-bottom:36px;">How Gift Cards Work</h2>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:var(--cream-deeper);">
      {howSteps.map(([num, title, desc]) => (
        <div style="background:var(--cream-dark);padding:32px 26px;transition:background var(--trans);" onmouseenter="this.style.background='var(--cream)'" onmouseleave="this.style.background='var(--cream-dark)'">
          <div style="font-family:var(--font-serif);font-size:40px;font-weight:700;color:var(--accent);opacity:.2;line-height:1;margin-bottom:12px;">{num}</div>
          <div class="h-card" style="margin-bottom:10px;">{title}</div>
          <p class="body-copy" style="font-size:12px;">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- INFO ROW -->
  <section class="section-wrap bg-cream">
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px;">
      {infoItems.map(([title, desc]) => (
        <div class="card card-accent-border">
          <div class="h-card">{title}</div>
          <p class="body-copy" style="font-size:12px;margin-top:10px;">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <BannerStrip
    eyebrow="Not Sure Which to Choose?"
    heading="A Gift Card Is Never the Wrong Answer."
    body="When you can't pick between pieces — or when you want them to experience the joy of choosing — a gift card gives them the shop, the craft, and the decision."
    ctaPrimary="Buy a Gift Card"
    ctaPrimaryHref="#"
    ctaSecondary="Browse the Collection"
    ctaSecondaryHref="/shop/"
  />

</BaseLayout>

<script>
  // Sync amount selectors with card preview
  const previewBtns   = document.querySelectorAll<HTMLButtonElement>('#preview-amounts .pill');
  const formBtns      = document.querySelectorAll<HTMLButtonElement>('#form-amounts .pill');
  const displayEl     = document.getElementById('gc-amount-display');
  const submitLabel   = document.getElementById('gc-submit-label');
  const customRow     = document.getElementById('custom-amount-row');

  function syncAmount(amt: string) {
    const display = amt === 'custom' ? 'Custom' : `$${amt}`;
    if (displayEl)   displayEl.textContent   = display;
    if (submitLabel) submitLabel.textContent  = display;
  }

  previewBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      previewBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      syncAmount(btn.dataset.amount ?? '75');
      // Mirror to form
      formBtns.forEach(b => {
        b.classList.toggle('selected', b.dataset.amount === btn.dataset.amount);
      });
    });
  });

  formBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      formBtns.forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      const amt = btn.dataset.amount ?? '75';
      if (customRow) customRow.style.display = amt === 'custom' ? 'flex' : 'none';
      syncAmount(amt);
      // Mirror to preview
      previewBtns.forEach(b => {
        b.classList.toggle('active', b.dataset.amount === amt);
      });
    });
  });
</script>
