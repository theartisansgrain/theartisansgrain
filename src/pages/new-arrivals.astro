---
// src/pages/new-arrivals.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import ProductCard from '@components/ProductCard.astro';
import { PRODUCTS } from '@data/site';

const newProducts  = PRODUCTS.filter(p => p.isNew);
const allProducts  = PRODUCTS;
const featured     = newProducts[0] ?? PRODUCTS[0];
const recentGrid   = newProducts.slice(1, 5);

const dropHistory = [
  { date: 'Apr 2025', name: 'Midnight Tide',    resin: 'Navy & Cobalt Resin',     available: true  },
  { date: 'Apr 2025', name: 'Nebula Drift',     resin: 'Galaxy Resin',             available: true  },
  { date: 'Apr 2025', name: 'Champagne Toast',  resin: 'Champagne Mica Resin',     available: true  },
  { date: 'Apr 2025', name: 'Rose & Cedar',     resin: 'Rose Resin',               available: true  },
  { date: 'Mar 2025', name: 'Harvest Gold',     resin: 'Gold Mica Resin',          available: true  },
  { date: 'Mar 2025', name: 'Slate & Storm',    resin: 'Slate Blue Resin',         available: true  },
  { date: 'Mar 2025', name: 'Onyx & Cedar',     resin: 'Onyx Black Resin',         available: true  },
  { date: 'Feb 2025', name: 'Forest Floor',     resin: 'Forest Green Resin',       available: true  },
  { date: 'Feb 2025', name: 'Ember Deep',       resin: 'Crimson Resin',            available: false },
  { date: 'Jan 2025', name: 'Violet Storm',     resin: 'Deep Violet Resin',        available: false },
  { date: 'Jan 2025', name: 'Ocean Drift',      resin: 'Ocean Blue Blend',         available: false },
  { date: 'Dec 2024', name: 'Midnight Canvas',  resin: 'Onyx & Gold Blend',        available: false },
];
---

<BaseLayout
  title="New Arrivals"
  description="The latest pieces fresh from the workshop — new cedar and epoxy bow ties, just finished."
>
  <Hero
    eyebrow="Fresh from the Workshop"
    title="New Arrivals.<br><em>Just Finished.</em>"
    quote="New pieces land without warning. The only way to know is to be on the list."
    height={360}
  />

  <!-- NOTIFY STRIP -->
  <div class="bg-accent" style="padding:16px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;">
    <p style="font-family:var(--font-sans);font-size:12px;font-weight:400;color:rgba(245,239,224,.9);">
      <strong>Never miss a drop.</strong> New pieces sell fast — sign up to be notified the moment something new is listed.
    </p>
    <form class="waitlist-form notify-strip-form" style="display:flex;" novalidate>
      <input type="email" name="email" class="field-input" style="width:240px;background:rgba(245,239,224,.92);" placeholder="your@email.com" required />
      <button type="submit" class="btn btn-primary btn-sm" style="border-radius:0;">Notify Me</button>
    </form>
  </div>

  <!-- FEATURED NEWEST -->
  {featured && (
    <div class="split-grid" style="min-height:460px;">
      <div class="panel-mid" style="position:relative;">
        <svg style="position:absolute;inset:0;opacity:.12;width:100%;height:100%;" viewBox="0 0 600 460" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <path d="M0 45 Q150 32 300 50 Q450 68 600 44" stroke="#F5EFE0" stroke-width="1.5" fill="none"/>
          <path d="M0 150 Q120 136 240 156 Q380 178 600 146" stroke="#F5EFE0" stroke-width="1" fill="none"/>
          <path d="M0 280 Q100 266 200 286 Q350 308 600 274" stroke="#F5EFE0" stroke-width="2" fill="none"/>
          <path d="M0 400 Q180 387 360 407 Q480 423 600 393" stroke="#F5EFE0" stroke-width="1" fill="none"/>
        </svg>
        <span style="position:absolute;top:22px;left:22px;z-index:3;font-family:var(--font-sans);font-size:9px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;background:var(--accent);color:var(--cream);padding:5px 12px;">Just Listed</span>
        <div style="position:relative;z-index:2;width:100%;max-width:320px;">
          <!-- Large bow tie SVG -->
          <svg viewBox="0 0 360 230" fill="none" style="width:100%;" aria-label={featured.name}>
            <path d="M18 115 C38 67 94 63 180 115 C94 167 38 163 18 115Z" fill="#6B3D22" stroke="#8B5A30" stroke-width="1.5"/>
            <path d="M342 115 C322 67 266 63 180 115 C266 167 322 163 342 115Z" fill="#6B3D22" stroke="#8B5A30" stroke-width="1.5"/>
            <path d="M158 85 C166 97 166 133 158 145 L202 145 C194 133 194 97 202 85Z" fill="#5C3418" stroke="#8B5A30" stroke-width="1.5"/>
            <path d="M28 100 Q180 86 332 100" stroke="#A0693A" stroke-width="1.8" fill="none" opacity=".5"/>
            <path d="M28 115 Q180 101 332 115" stroke="#8B5A30" stroke-width="2.2" fill="none" opacity=".6"/>
            <path d="M28 130 Q180 116 332 130" stroke="#A0693A" stroke-width="1.8" fill="none" opacity=".5"/>
            <defs>
              <linearGradient id="featured-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#C4872A"/>
                <stop offset="100%" stop-color="#E8A84A"/>
              </linearGradient>
            </defs>
            <path d="M30 107 Q180 94 330 107" stroke="url(#featured-grad)" stroke-width="5" fill="none"/>
            <path d="M30 117 Q180 104 330 117" stroke="url(#featured-grad)" stroke-width="4.5" fill="none" opacity=".85"/>
            <path d="M30 127 Q180 114 330 127" stroke="url(#featured-grad)" stroke-width="4" fill="none" opacity=".7"/>
          </svg>
        </div>
      </div>
      <div class="panel-light">
        <div class="eyebrow">Featured New Arrival</div>
        <h2 style="font-family:var(--font-serif);font-size:32px;font-weight:700;color:var(--brown);margin-bottom:8px;">{featured.name}</h2>
        <div style="font-family:var(--font-sans);font-size:11px;font-weight:400;letter-spacing:.15em;text-transform:uppercase;color:var(--text-mid);margin-bottom:18px;">
          Piece No. {featured.pieceNum} · Western Red Cedar
        </div>
        <p class="body-copy" style="margin-bottom:24px;">{featured.desc}</p>
        <div style="display:flex;align-items:center;gap:20px;margin-bottom:14px;">
          <span style="font-family:var(--font-serif);font-size:26px;font-weight:700;color:var(--brown);">${featured.price}</span>
          {featured.inStock ? (
            <a href={`/shop/${featured.slug}/`} class="btn btn-primary">Add to Cart</a>
          ) : (
            <span class="btn btn-sm" style="background:var(--cream-deeper);color:var(--text-mid);cursor:default;">Sold Out</span>
          )}
        </div>
        <p style="font-family:var(--font-sans);font-size:11px;font-weight:300;color:var(--text-mid);">
          Western Red Cedar · {featured.resin} · Ships in 3–5 days · Lifetime guarantee
        </p>
      </div>
    </div>
  )}

  <!-- RECENT ARRIVALS GRID -->
  <section class="section-wrap bg-cream">
    <div class="section-header">
      <div>
        <div class="eyebrow">This Month</div>
        <h2 class="h-section">Recent Additions</h2>
      </div>
      <p class="section-right-note">Pieces added in the last 30 days. Each completed and inspected before listing.</p>
    </div>
    {recentGrid.length > 0 ? (
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:2px;background:var(--cream-deeper);">
        {recentGrid.map(product => (
          <article class="product-card" style="display:grid;grid-template-columns:200px 1fr;border:none;" itemscope itemtype="https://schema.org/Product">
            <a href={`/shop/${product.slug}/`} class="pc-image" style="aspect-ratio:auto;min-height:180px;">
              <svg viewBox="0 0 200 130" fill="none" style="width:130px;" aria-hidden="true">
                <path d="M8 65 C18 40 42 38 100 65 C42 92 18 90 8 65Z" fill="#6B3D22" stroke="#8B5A30" stroke-width="1"/>
                <path d="M192 65 C182 40 158 38 100 65 C158 92 182 90 192 65Z" fill="#6B3D22" stroke="#8B5A30" stroke-width="1"/>
                <path d="M88 50 C92 57 92 73 88 80 L112 80 C108 73 108 57 112 50Z" fill="#5C3418" stroke="#8B5A30" stroke-width="1"/>
                <path d="M14 58 Q100 50 186 58" stroke="#C4872A" stroke-width="2.5" fill="none"/>
                <path d="M14 68 Q100 60 186 68" stroke="#A0693A" stroke-width="2" fill="none"/>
              </svg>
            </a>
            <div class="pc-body">
              <div class="eyebrow" style="margin-bottom:6px;">New · Piece No. {product.pieceNum}</div>
              <div class="pc-name" itemprop="name">
                <a href={`/shop/${product.slug}/`}>{product.name}</a>
              </div>
              <div class="pc-wood">Western Red Cedar · {product.resin}</div>
              <p class="body-copy" style="font-size:12px;margin-bottom:16px;">{product.shortDesc}</p>
              <div class="pc-footer">
                <span class="pc-price">${product.price}</span>
                {product.inStock ? (
                  <a href={`/shop/${product.slug}/`} class="btn btn-primary btn-sm">Add to Cart</a>
                ) : (
                  <span class="btn btn-sm" style="background:var(--cream-deeper);color:var(--text-mid);cursor:default;">Sold Out</span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
        {allProducts.slice(0, 3).map(p => <ProductCard product={p} />)}
      </div>
    )}
  </section>

  <!-- DROP HISTORY -->
  <section class="section-wrap bg-dark">
    <svg style="position:absolute;inset:0;opacity:.07;width:100%;height:100%;" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path d="M0 60 Q300 44 600 68 Q900 92 1200 58" stroke="#C4872A" stroke-width="1" fill="none"/>
      <path d="M0 200 Q250 184 500 208 Q800 236 1200 198" stroke="#A0693A" stroke-width="1.5" fill="none"/>
      <path d="M0 340 Q200 325 400 348 Q700 375 1200 338" stroke="#C4872A" stroke-width="1" fill="none"/>
    </svg>
    <div style="position:relative;z-index:2;">
      <div class="eyebrow">The Archive</div>
      <h2 class="h-section text-cream" style="margin-bottom:36px;">Previous Drops</h2>
      <div style="display:flex;flex-direction:column;">
        {dropHistory.map(d => (
          <div style="display:flex;align-items:center;gap:32px;padding:18px 0;border-bottom:1px solid rgba(245,239,224,.07);">
            <span style="font-family:var(--font-serif);font-size:11px;font-weight:400;letter-spacing:.15em;color:rgba(245,239,224,.3);min-width:80px;">{d.date}</span>
            <span style="font-family:var(--font-serif);font-size:15px;font-weight:600;color:var(--cream);flex:1;">{d.name}</span>
            <span style="font-family:var(--font-sans);font-size:11px;font-weight:300;color:rgba(245,239,224,.4);min-width:180px;">{d.resin}</span>
            <span style={`font-family:var(--font-sans);font-size:9px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;padding:4px 10px;${d.available ? 'background:rgba(196,135,42,.2);color:var(--accent);' : 'background:rgba(245,239,224,.06);color:rgba(245,239,224,.3);'}`}>
              {d.available ? 'Available' : 'Sold Out'}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WAITLIST -->
  <section class="section-wrap bg-cream-d">
    <div class="split-grid" style="gap:56px;align-items:center;">
      <div>
        <div class="eyebrow">Stay in the Loop</div>
        <h2 class="h-section" style="margin-bottom:16px;">New Pieces Land Without Warning.</h2>
        <p class="body-copy">We finish a piece when it's ready, not on a schedule. The only way to know is to be on the list — new arrivals sell out before most people even see them.</p>
      </div>
      <form class="waitlist-form" style="display:flex;flex-direction:column;gap:14px;" novalidate>
        <label class="field-label" for="wl-name">First Name</label>
        <input class="field-input" type="text" id="wl-name" name="name" autocomplete="given-name" placeholder="First name" />
        <label class="field-label" for="wl-email">Email Address</label>
        <input class="field-input" type="email" id="wl-email" name="email" required autocomplete="email" placeholder="your@email.com" />
        <button type="submit" class="btn btn-primary" style="padding:14px;">Notify Me of New Drops</button>
        <p style="font-family:var(--font-sans);font-size:10px;font-weight:300;color:var(--text-mid);">No spam. No frequency promises. Just a note when something new is ready.</p>
      </form>
    </div>
  </section>

</BaseLayout>
