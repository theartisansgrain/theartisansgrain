---
// src/pages/contact.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import { SITE } from '@data/site';

const hours = [
  ['Monday – Friday', '9am – 6pm CST'],
  ['Saturday',        '10am – 3pm CST'],
  ['Sunday',          'Closed'],
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with The Artisan's Grain — a real person reads every message and writes back within 48 hours."
>
  <link slot="head" rel="stylesheet" href="/styles/pages/shop.css" />

  <Hero
    eyebrow="Get in Touch"
    title="Talk to the<br><em>Maker.</em>"
    quote="There's no ticketing system here. When you write to us, a real person reads it and writes back."
    height={300}
  />

  <div class="split-grid contact-main">

    <!-- LEFT: Info -->
    <div class="panel-dark">
      <svg class="panel-grain" viewBox="0 0 500 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <path d="M0 60 Q125 48 250 65 Q375 82 500 58" stroke="#C4872A" stroke-width="1" fill="none"/>
        <path d="M0 200 Q100 186 200 204 Q350 225 500 194" stroke="#A0693A" stroke-width="1.5" fill="none"/>
        <path d="M0 360 Q140 346 280 366 Q400 384 500 356" stroke="#C4872A" stroke-width="1" fill="none"/>
        <path d="M0 530 Q160 517 320 536 Q430 550 500 524" stroke="#8B5A30" stroke-width="1.2" fill="none"/>
      </svg>
      <div class="panel-dark-inner">
        <div class="eyebrow">How to Reach Us</div>
        <h2 class="h-section text-cream" style="margin-bottom:20px;">We're a Small Shop.<br>We Actually Answer.</h2>
        <p class="body-copy" style="color:rgba(245,239,224,.6);margin-bottom:32px;">
          This isn't a brand with a support department. It's a workshop in Cleburne, Texas. When you send a message, the person who reads it is the same person who made your bow tie.
        </p>

        {[
          ['Email', SITE.email, 'Replies within 48 hours'],
          ['Instagram DMs', '@theartisansgrain', 'Great for sharing inspiration photos'],
          ['Phone', 'Available by appointment', "Email first — we'll set up a call"],
        ].map(([title, val, sub]) => (
          <div style="display:flex;gap:14px;align-items:flex-start;margin-bottom:18px;">
            <div class="icon-node" style="border-color:rgba(196,135,42,.3);background:transparent;flex-shrink:0;">
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1" y="3" width="14" height="10" rx="1.5" stroke="#C4872A" stroke-width="1.2"/><path d="M1 6 Q8 10 15 6" stroke="#C4872A" stroke-width="1.1" fill="none"/></svg>
            </div>
            <div>
              <div style="font-family:var(--font-serif);font-size:13px;font-weight:600;color:var(--cream);margin-bottom:3px;">{title}</div>
              <div style="font-family:var(--font-sans);font-size:12px;font-weight:300;color:rgba(245,239,224,.55);line-height:1.6;">{val}<br><span style="opacity:.7">{sub}</span></div>
            </div>
          </div>
        ))}

        <div style="margin-top:28px;padding-top:24px;border-top:1px solid rgba(245,239,224,.08);">
          <div class="eyebrow" style="margin-bottom:12px;">Workshop Hours</div>
          {hours.map(([day, time]) => (
            <div style="display:flex;justify-content:space-between;margin-bottom:7px;">
              <span style="font-family:var(--font-sans);font-size:12px;font-weight:300;color:rgba(245,239,224,.5);">{day}</span>
              <span style="font-family:var(--font-sans);font-size:12px;font-weight:400;color:rgba(245,239,224,.75);">{time}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- RIGHT: Form -->
    <div class="panel-light">
      <h2 class="h-section" style="margin-bottom:6px;">Send Us a Message</h2>
      <p class="body-copy" style="margin-bottom:28px;">A real person reads every message and writes back within 48 hours.</p>

      <div class="form-row">
        <div class="field-label">What's This About?</div>
        <div class="subject-pills">
          {['Custom Order','Existing Order','Shipping Question','Return / Repair','Wholesale','Press / Media','Just Saying Hi'].map(s => (
            <button type="button" class="pill subject-pill">{s}</button>
          ))}
        </div>
      </div>

      <form id="contact-form" novalidate>
        <div class="form-row-2">
          <div>
            <label class="field-label" for="cf-first">First Name</label>
            <input class="field-input" type="text" id="cf-first" name="first_name" required autocomplete="given-name" />
          </div>
          <div>
            <label class="field-label" for="cf-last">Last Name</label>
            <input class="field-input" type="text" id="cf-last" name="last_name" required autocomplete="family-name" />
          </div>
        </div>
        <div class="form-row">
          <label class="field-label" for="cf-email">Email Address</label>
          <input class="field-input" type="email" id="cf-email" name="email" required autocomplete="email" />
        </div>
        <div class="form-row" id="order-num-row" style="display:none;">
          <label class="field-label" for="cf-order">Order Number</label>
          <input class="field-input" type="text" id="cf-order" name="order_number" placeholder="e.g. TAG-2024-0042" />
        </div>
        <div class="form-row">
          <label class="field-label" for="cf-message">Your Message</label>
          <textarea class="field-textarea" id="cf-message" name="message" required rows="5" placeholder="Tell us what you need — there's no wrong way to write this."></textarea>
        </div>
        <div id="contact-feedback" aria-live="polite"></div>
        <button type="submit" class="btn btn-primary" style="width:100%;padding:17px;" id="contact-submit">Send Message</button>
        <p class="body-copy" style="font-size:10px;text-align:center;margin-top:10px;color:var(--text-mid);">We reply within 48 hours, Mon–Sat. No automated responses.</p>
      </form>
    </div>
  </div>

  <!-- RESPONSE STRIP -->
  <div class="section-wrap bg-cream-d">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:32px;align-items:center;">
      {[
        ['48-Hour Reply',          'We respond to every message within two business days.'],
        ['Real Person, Every Time','No bots, no templates, no ticketing system. Just us.'],
        [SITE.email,               'Email is the best way to reach us. We check it daily.'],
        [SITE.location,            'Made in Johnson County. Ships nationwide & internationally.'],
      ].map(([title, desc]) => (
        <div style="display:flex;align-items:flex-start;gap:14px;">
          <div class="icon-node">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7" stroke="#C4872A" stroke-width="1.5"/><path d="M10 6 v4 l3 3" stroke="#6B3D22" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <div>
            <div style="font-family:var(--font-serif);font-size:13px;font-weight:600;color:var(--brown);margin-bottom:4px;">{title}</div>
            <p class="body-copy" style="font-size:11px;">{desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</BaseLayout>
