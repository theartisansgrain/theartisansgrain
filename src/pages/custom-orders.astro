---
// src/pages/custom-orders.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import FaqAccordion from '@components/FaqAccordion.astro';
import BannerStrip from '@components/BannerStrip.astro';
import { SITE } from '@data/site';

const occasions = [
  ['Weddings',                'Match the resin to your wedding colours or floral palette'],
  ["Groomsmen Gifts",         'Matching sets or individual pieces for the whole party'],
  ["Father's Day & Birthdays","Something genuinely unique for someone who has everything"],
  ['Corporate & Awards',      'Brand colours, team spirit, or executive gifting'],
  ['Milestone Events',        'Graduations, anniversaries, retirements, promotions'],
];

const procSteps = [
  ['01','Tell Us Your Vision',    "Fill out the commission form below — occasion, colours you love, any inspiration. The more detail, the better."],
  ['02','We Reach Out (48 hrs)',  "We'll respond within 48 hours to confirm details and lock in the design direction."],
  ['03','We Build Your Piece',    "Cedar selected, laser-cut, hand-routed, resin poured and cured, shaped, sanded, oiled, waxed, and finished."],
  ['04','Delivered to Your Door', "Wrapped, numbered, and signed. Shipped with care — ready to wear or gift exactly as it arrives."],
];

const colours = [
  ['linear-gradient(135deg,#1a3a5c,#2e6da4)','Midnight Blue'],
  ['linear-gradient(135deg,#6b1a8a,#a855c8)','Violet'],
  ['linear-gradient(135deg,#8b0000,#c0392b)','Deep Red'],
  ['linear-gradient(135deg,#1a6b3a,#27ae60)','Forest Green'],
  ['linear-gradient(135deg,#b8860b,#f1c40f)','Gold'],
  ['linear-gradient(135deg,#1a4a6b,#2e86c1,#8e44ad)','Ocean Blend'],
  ['linear-gradient(135deg,#2c3e50,#4a6fa5)','Slate'],
  ['linear-gradient(135deg,#c0392b,#e67e22)','Sunset'],
  ['linear-gradient(135deg,#1b4332,#40916c)','Sage'],
  ['linear-gradient(135deg,#4a0e8f,#c0392b,#e67e22)','Galaxy'],
  ['linear-gradient(135deg,#e8d5b7,#d4af7a)','Champagne'],
  ['linear-gradient(135deg,#1c1c1c,#3a3a3a)','Onyx'],
  ['linear-gradient(135deg,#8b1a4a,#c0527a)','Rose'],
  ['radial-gradient(circle,#fff 10%,#c8a8d8 40%,#6b1a8a 100%)','Mica Pearl'],
];

const faqItems = [
  {q:"How much does a custom bow tie cost?",a:"Custom pieces start at the same price as our standard collection. Multi-piece orders are priced per piece — just mention the quantity in your request."},
  {q:"How long does a custom order take?",a:"From confirmed design to shipped: typically 2–3 weeks. The epoxy cure alone takes several days, and we won't rush that."},
  {q:"Can I match my wedding colours exactly?",a:"Very close, yes. We mix every resin colour by hand, so we can dial in shade, tone, and shimmer to match a swatch, a photo, or a hex code."},
  {q:"Do you do matching sets for wedding parties?",a:"Yes — this is one of the most common requests we get. We can make identical pieces for the whole party, or slight variations that look cohesive without being factory-stamped."},
  {q:"When do I pay? Is there a deposit?",a:"No payment until we've had a conversation and confirmed the design together. We don't take your money until we're both confident the piece is exactly what you want."},
  {q:"Can I add engraving or personalisation?",a:"Every bow tie is already signed and numbered on the back — that's standard. Beyond that, ask us what you have in mind. We have the laser, after all."},
];

const occButtons = ['Wedding','Groomsmen Gift','Birthday',"Father's Day",'Anniversary','Corporate Gift','Graduation','Just Because','Other'];
---

<BaseLayout
  title="Custom Orders"
  description="Commission a custom cedar and epoxy bow tie — your colours, your occasion, built from scratch with the same twelve-step process and lifetime guarantee."
>
  <Hero
    eyebrow="Commission Your Piece"
    title="Made for You.<br><em>Nobody Else.</em>"
    quote="Tell us the occasion, the colour, the feeling you're after. We'll handle everything else."
    height={400}
  />

  <!-- INTRO SPLIT -->
  <div class="split-grid">
    <div class="panel-dark">
      <svg class="panel-grain" viewBox="0 0 600 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <path d="M0 50 Q150 38 300 55 Q450 72 600 48" stroke="#C4872A" stroke-width="1" fill="none"/>
        <path d="M0 180 Q120 166 240 186 Q380 208 600 176" stroke="#A0693A" stroke-width="1.5" fill="none"/>
        <path d="M0 330 Q140 316 280 336 Q400 354 600 324" stroke="#C4872A" stroke-width="1" fill="none"/>
      </svg>
      <div class="panel-dark-inner">
        <div class="eyebrow">Why Custom</div>
        <h2 class="h-section text-cream" style="margin-bottom:22px;">A Bow Tie That Tells Your Story.</h2>
        <p class="body-copy" style="color:rgba(245,239,224,.65);margin-bottom:14px;">Every bow tie we make is already one-of-a-kind. A custom commission takes that further. You choose the resin colour — we match it to your suit, your flowers, your partner's dress, your team colours — whatever carries meaning for you.</p>
        <p class="body-copy" style="color:rgba(245,239,224,.65);">We don't offer a drop-down menu of preset combos. We have a conversation, figure out what you're after, and build the piece from scratch around that.</p>
      </div>
    </div>
    <div class="panel-light">
      <div style="font-family:var(--font-sans);font-size:10px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent);margin-bottom:16px;">Popular Occasions</div>
      <h3 class="h-section" style="font-size:20px;margin-bottom:24px;">When People Commission a Piece</h3>
      <div style="display:flex;flex-direction:column;gap:10px;">
        {occasions.map(([name, sub]) => (
          <div style="display:flex;align-items:center;gap:16px;padding:12px 16px;background:var(--cream-dark);border-left:3px solid var(--accent);">
            <div>
              <div style="font-family:var(--font-serif);font-size:13px;font-weight:600;color:var(--brown);margin-bottom:2px;">{name}</div>
              <div style="font-family:var(--font-sans);font-size:11px;font-weight:300;color:var(--text-mid);">{sub}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- PROCESS -->
  <section class="section-wrap bg-cream-d">
    <div class="eyebrow">How It Works</div>
    <h2 class="h-section" style="margin-bottom:8px;">From Conversation to Creation</h2>
    <p class="body-copy" style="margin-bottom:40px;max-width:540px;">Commissioning a custom piece is straightforward. We do the heavy lifting — you make the decisions that matter.</p>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:var(--cream-deeper);">
      {procSteps.map(([num, title, desc]) => (
        <div style="background:var(--cream-dark);padding:36px 28px;transition:background var(--trans);" onmouseenter="this.style.background='var(--cream)'" onmouseleave="this.style.background='var(--cream-dark)'">
          <div style="font-family:var(--font-serif);font-size:44px;font-weight:700;color:var(--accent);opacity:.18;line-height:1;margin-bottom:14px;">{num}</div>
          <div class="h-card" style="margin-bottom:10px;">{title}</div>
          <p class="body-copy" style="font-size:12px;">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- COLOURS -->
  <section class="section-wrap bg-brown" style="position:relative;overflow:hidden;">
    <div class="eyebrow">Resin Colours</div>
    <h2 class="h-section text-cream" style="margin-bottom:8px;">Pick Your Palette.</h2>
    <p class="body-copy" style="color:rgba(245,239,224,.5);margin-bottom:36px;max-width:420px;">Starting points — every colour can be adjusted. If you have a reference, send it our way.</p>
    <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:20px;">
      {colours.map(([grad, name]) => (
        <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
          <div class="colour-swatch" style={`width:60px;height:60px;background:${grad};border-color:rgba(245,239,224,.15);`}></div>
          <div style="font-family:var(--font-sans);font-size:9px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:rgba(245,239,224,.45);text-align:center;">{name}</div>
        </div>
      ))}
    </div>
    <p style="margin-top:28px;text-align:center;font-family:var(--font-sans);font-size:12px;font-weight:300;font-style:italic;color:rgba(245,239,224,.35);">Don't see what you're after? Describe it in the form — we mix custom colours from scratch every time.</p>
  </section>

  <!-- FORM -->
  <section class="section-wrap bg-cream" id="commission-form">
    <div class="split-grid" style="gap:56px;align-items:start;">
      <div>
        <div class="eyebrow">Start Here</div>
        <h2 class="h-section" style="margin-bottom:18px;">Tell Us About Your Piece.</h2>
        <p class="body-copy" style="margin-bottom:14px;">This form goes directly to the maker — the person who will actually cut, pour, and finish your bow tie.</p>
        <p class="body-copy" style="margin-bottom:28px;">Custom orders typically take 2–3 weeks from confirmation to shipping. If you have a hard deadline, tell us and we'll let you know if we can make it work.</p>
        <div class="info-box" style="border-color:#27ae60;background:rgba(39,174,96,.06);">
          <div class="info-box-title" style="color:#1a6b3a;">Our Custom Promise</div>
          <p class="info-box-body">No deposit until we've confirmed your design together. Every custom piece carries the same lifetime guarantee as our standard collection.</p>
        </div>
        <div style="margin-top:22px;padding:20px;border:1px solid var(--cream-deeper);">
          <div style="font-family:var(--font-serif);font-size:12px;font-weight:600;color:var(--brown);margin-bottom:10px;">Prefer to Reach Out Directly?</div>
          <a href={`mailto:${SITE.email}`} style="font-family:var(--font-sans);font-size:12px;color:var(--accent);">{SITE.email}</a>
          <div style="font-family:var(--font-sans);font-size:11px;color:var(--text-mid);margin-top:4px;">We respond within 48 hours, always.</div>
        </div>
      </div>

      <div style="background:var(--cream-dark);padding:44px 40px;border:1px solid var(--cream-deeper);">
        <h3 style="font-family:var(--font-serif);font-size:20px;font-weight:600;color:var(--brown);margin-bottom:4px;">Commission Request</h3>
        <p class="body-copy" style="font-size:12px;margin-bottom:28px;">Every field helps us build a better piece for you.</p>

        <form id="commission-req" novalidate>
          <div class="form-row-2">
            <div>
              <label class="field-label" for="com-first">First Name</label>
              <input class="field-input" type="text" id="com-first" name="first_name" required autocomplete="given-name" />
            </div>
            <div>
              <label class="field-label" for="com-last">Last Name</label>
              <input class="field-input" type="text" id="com-last" name="last_name" required autocomplete="family-name" />
            </div>
          </div>
          <div class="form-row">
            <label class="field-label" for="com-email">Email Address</label>
            <input class="field-input" type="email" id="com-email" name="email" required autocomplete="email" />
          </div>
          <div class="form-row">
            <div class="field-label">What's the Occasion?</div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;">
              {occButtons.map(o => (
                <button type="button" class="pill subject-pill">{o}</button>
              ))}
            </div>
          </div>
          <div class="form-row-2">
            <div>
              <label class="field-label" for="com-qty">How Many Pieces?</label>
              <select class="field-select" id="com-qty" name="quantity">
                <option>1 bow tie</option>
                <option>2 bow ties</option>
                <option>3–5 (small party)</option>
                <option>6–10 (wedding party)</option>
                <option>11+ (large order)</option>
              </select>
            </div>
            <div>
              <label class="field-label" for="com-deadline">Deadline?</label>
              <input class="field-input" type="date" id="com-deadline" name="deadline" />
            </div>
          </div>
          <div class="form-row">
            <label class="field-label" for="com-colour">Colour Vision</label>
            <input class="field-input" type="text" id="com-colour" name="colour_vision" placeholder="e.g. deep navy with a gold shimmer" />
          </div>
          <div class="form-row">
            <label class="field-label" for="com-notes">Anything Else?</label>
            <textarea class="field-textarea" id="com-notes" name="message" rows="4" placeholder="Suit colour, inspiration photos, the story behind the occasion — anything helps."></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;padding:17px;"
                  onclick="this.textContent='Request Sent — We\'ll Be in Touch Within 48 Hours';this.style.background='var(--brown-mid)';this.disabled=true;event.preventDefault();">
            Send My Commission Request
          </button>
          <p class="body-copy" style="font-size:10px;text-align:center;margin-top:12px;color:var(--text-mid);">
            We'll respond within 48 hours. No payment collected until design is confirmed.
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-wrap bg-dark">
    <div class="section-header">
      <div>
        <div class="eyebrow">Common Questions</div>
        <h2 class="h-section text-cream">Custom Order FAQ</h2>
      </div>
      <p class="text-muted" style="max-width:280px;text-align:right;">Still have questions? Email us directly — we answer every one.</p>
    </div>
    <FaqAccordion items={faqItems} dark grid />
  </section>

  <BannerStrip
    eyebrow="Ready to Start?"
    heading="Every Great Piece Starts with a Conversation."
    body="You don't need to have it all figured out. Tell us the occasion, a colour direction, and a deadline if you have one. We'll take it from there."
    ctaPrimary="Start My Commission"
    ctaPrimaryHref="#commission-form"
    ctaSecondary="Browse the Collection"
    ctaSecondaryHref="/shop/"
  />

</BaseLayout>
