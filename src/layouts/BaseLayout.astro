---
// src/layouts/BaseLayout.astro
import { SITE, NAV_LINKS, FOOTER_SHOP, FOOTER_INFO } from '@data/site';

interface Props {
  title?:       string;
  description?: string;
  pageClass?:   string;
}

const {
  title       = SITE.name,
  description = SITE.desc,
  pageClass   = '',
} = Astro.props;

const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{fullTitle}</title>

  <!-- Canonical -->
  <link rel="canonical" href={new URL(currentPath, SITE.url).href} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content={SITE.name} />
  <meta property="og:title"       content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url"         content={new URL(currentPath, SITE.url).href} />

  <!-- Favicon placeholder -->
  <link rel="icon" type="image/png" href="/images/logo.svg" />

  <!-- Global styles -->
  <link rel="stylesheet" href="/styles/global.css" />

  <!-- Slot for per-page head additions (extra CSS, etc.) -->
  <slot name="head" />
</head>

<body class={pageClass}>

  <!-- SITE HEADER -->
  <header class="site-header" id="masthead">
    <nav class="site-nav" aria-label="Primary Navigation">

      <!-- Logo -->
      <a href="/" class="nav-logo" aria-label={SITE.name}>
        <img src="/images/logo.svg" alt={SITE.name} width="50" height="50" />
        <span class="nav-brand-name">
          {SITE.name}
          <span class="nav-brand-sub">{SITE.tagline}</span>
        </span>
      </a>

      <!-- Mobile toggle -->
      <button
        class="nav-toggle"
        id="nav-toggle"
        aria-controls="primary-menu"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span></span><span></span><span></span>
      </button>

      <!-- Nav links -->
      <ul class="nav-menu" id="primary-menu" role="list">
        {NAV_LINKS.map(link => (
          <li>
            <a
              href={link.href}
              aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/shop/" class="nav-cart-btn" aria-label="View cart">
            Cart (0)
          </a>
        </li>
      </ul>

    </nav>
  </header>

  <!-- PAGE CONTENT -->
  <main id="main-content">
    <slot />
  </main>

  <!-- SITE FOOTER -->
  <footer class="site-footer" id="colophon">
    <div class="footer-top">

      <!-- Brand -->
      <div>
        <div class="footer-brand-name">{SITE.name}</div>
        <p class="footer-brand-desc">{SITE.desc}</p>
      </div>

      <!-- Shop links -->
      <nav aria-label="Footer Shop Links">
        <div class="footer-col-title">Shop</div>
        {FOOTER_SHOP.map(link => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>

      <!-- Info links -->
      <nav aria-label="Footer Info Links">
        <div class="footer-col-title">Info</div>
        {FOOTER_INFO.map(link => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>

    </div>

    <div class="footer-bottom">
      <div class="footer-copy">
        © {SITE.year} {SITE.name} · {SITE.location} · All rights reserved.
      </div>
      <div class="footer-logo">
        <img src="/images/logo.svg" alt={SITE.name} width="32" height="32" />
      </div>
    </div>
  </footer>

  <!-- Global JS -->
  <script src="/scripts/theme.js" is:inline></script>

</body>
</html>
